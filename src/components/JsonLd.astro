---
interface Props {
  data: {
    title?: string;
    subtitle?: string;
    description?: string;
    coverImage?: string;
    images?: Array<{
      src: string;
      caption?: string;
      description?: string;
      altText?: string;
      artworkType?: string;
      medium?: string;
      dimensions?: string;
      year?: string;
    }>;
    diptychImages?: Array<{
      src: string;
      caption?: string;
      description?: string;
      altText?: string;
      artworkType?: string;
      medium?: string;
      dimensions?: string;
      year?: string;
    }>;
    detailImages?: Array<{
      src: string;
      caption?: string;
      description?: string;
      artworkType?: string;
      medium?: string;
      dimensions?: string;
      year?: string;
    }>;
    exhibitionImages?: Array<{
      src: string;
      caption?: string;
      description?: string;
      artworkType?: string;
      medium?: string;
      dimensions?: string;
      year?: string;
    }>;
  };
}

const { data } = Astro.props;
const siteUrl = (Astro.site?.href || '').replace(/\/$/, '');
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const imageBase = siteUrl + basePath;

function extractTitle(caption?: string): string {
  if (!caption) return '';
  return caption.split(',')[0].trim();
}

function buildArtwork(img: any) {
  const obj: Record<string, any> = {
    '@type': img.artworkType || 'VisualArtwork',
    name: extractTitle(img.caption),
  };
  if (img.description) obj.description = img.description;
  if (img.year) obj.dateCreated = img.year;
  if (img.medium) obj.artMedium = img.medium;
  if (img.dimensions) {
    obj.additionalProperty = [{
      '@type': 'PropertyValue',
      name: 'dimensions',
      value: img.dimensions,
    }];
  }
  if (img.src) obj.image = imageBase + img.src;
  return obj;
}

const allImages = [
  ...(data.images || []),
  ...(data.diptychImages || []),
  ...(data.detailImages || []),
  ...(data.exhibitionImages || []),
];

const artworks = allImages.filter(img => img.src).map(buildArtwork);

const seriesName = data.title || '';
const seriesDesc = data.description || data.subtitle || '';

const jsonLd: Record<string, any> = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: seriesName,
};

if (seriesDesc) jsonLd.description = seriesDesc;

const seriesEntity: Record<string, any> = {
  '@type': 'CreativeWorkSeries',
  name: seriesName,
};

if (seriesDesc) seriesEntity.description = seriesDesc;
if (data.coverImage) seriesEntity.image = imageBase + data.coverImage;
if (artworks.length > 0) seriesEntity.hasPart = artworks;

jsonLd.mainEntity = seriesEntity;
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
