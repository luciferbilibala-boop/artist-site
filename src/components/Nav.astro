---
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const links = [
  { href: `${base}/works`, label: 'Works' },
  { href: `${base}/method`, label: 'Method' },
  { href: `${base}/notes`, label: 'Notes' },
  { href: `${base}/archive`, label: 'Archive' },
  { href: `${base}/about`, label: 'About' },
  { href: `${base}/studio`, label: 'Studio' },
  { href: `${base}/contact`, label: 'Contact' },
];

function isActive(href: string): boolean {
  if (href === `${base}/` || href === base) return currentPath === `${base}/` || currentPath === base;
  return currentPath.startsWith(href);
}
---

<header class="nav-header">
  <a href={`${base}/`} class="nav-logo">BAI</a>
  <button
    class="nav-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="site-nav"
  >
    Menu
  </button>
  <nav id="site-nav" class="site-nav">
    <ul class="nav-list">
      {links.map(link => (
        <li>
          <a
            href={link.href}
            class:list={['nav-link', { active: isActive(link.href) }]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .nav-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem var(--spacing-md);
    mix-blend-mode: difference;
    color: white;
  }

  .nav-logo {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .nav-toggle {
    display: none;
  }

  .nav-list {
    display: flex;
    gap: 2rem;
    list-style: none;
  }

  .nav-link {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.5;
    transition: opacity 0.2s ease;
  }

  .nav-link.active,
  .nav-link:hover {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .nav-header {
      padding: 1rem var(--spacing-sm);
      mix-blend-mode: normal;
      color: var(--color-text);
      background: color-mix(in srgb, var(--color-bg) 92%, transparent);
      border-bottom: 1px solid var(--color-border);
      backdrop-filter: blur(16px);
    }

    .nav-toggle {
      display: inline-flex;
      align-items: center;
      min-height: 36px;
      border: 0;
      background: transparent;
      color: inherit;
      font: inherit;
      font-size: 0.75rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      cursor: pointer;
    }

    .site-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: none;
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
      padding: var(--spacing-md) var(--spacing-sm);
    }

    .nav-header.is-open .site-nav {
      display: block;
    }

    .nav-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--spacing-md) var(--spacing-sm);
    }

    .nav-link {
      display: block;
      font-size: 0.8125rem;
      opacity: 0.7;
    }
  }
</style>

<script>
  const navHeader = document.querySelector('.nav-header');
  const navToggle = document.querySelector('.nav-toggle');

  if (navHeader && navToggle) {
    navToggle.addEventListener('click', () => {
      const isOpen = navHeader.classList.toggle('is-open');
      navToggle.setAttribute('aria-expanded', String(isOpen));
    });

    navHeader.querySelectorAll('.nav-link').forEach((link) => {
      link.addEventListener('click', () => {
        navHeader.classList.remove('is-open');
        navToggle.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
