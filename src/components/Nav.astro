---
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const links = [
  { href: `${base}/works`, label: 'Works' },
  { href: `${base}/method`, label: 'Method' },
  { href: `${base}/notes`, label: 'Notes' },
  { href: `${base}/archive`, label: 'Archive' },
  { href: `${base}/about`, label: 'About' },
  { href: `${base}/studio`, label: 'Studio' },
  { href: `${base}/contact`, label: 'Contact' },
];

function isActive(href: string): boolean {
  if (href === `${base}/` || href === base) return currentPath === `${base}/` || currentPath === base;
  return currentPath.startsWith(href);
}
---

<header class="nav-header">
  <a href={`${base}/`} class="nav-logo">BAI</a>
  <nav>
    <ul class="nav-list">
      {links.map(link => (
        <li>
          <a
            href={link.href}
            class:list={['nav-link', { active: isActive(link.href) }]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .nav-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem var(--spacing-md);
    mix-blend-mode: difference;
    color: white;
  }

  .nav-logo {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .nav-list {
    display: flex;
    gap: 2rem;
    list-style: none;
  }

  .nav-link {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.5;
    transition: opacity 0.2s ease;
  }

  .nav-link.active,
  .nav-link:hover {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .nav-header {
      padding: 1rem var(--spacing-sm);
    }

    .nav-list {
      gap: 1rem;
    }

    .nav-link {
      font-size: 0.7rem;
    }
  }
</style>
