---
import Layout from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('archive', ({ data }) => data);

const categories = ['秩序', '物证', '失控'] as const;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="INTJ Archive" description="秩序 · 物证 · 失控">
  <main class="archive-page page-padding">
    <header class="page-header">
      <h1 class="page-title">INTJ Archive</h1>
      <p class="page-subtitle">秩序 · 物证 · 失控</p>
      <p class="page-description">
        精神世界的构成
      </p>
    </header>

    <div class="archive-nav">
      <a href={`${base}/archive`} class="filter-link active">全部</a>
      {categories.map(cat => (
        <a href={`${base}/archive?category=${cat}`} class="filter-link">{cat}</a>
      ))}
    </div>

    <div class="archive-grid">
      {entries.map(entry => (
        <article class="archive-card">
          <div class="card-image" class:list={{ 'has-video': !!entry.data.video }}>
            {entry.data.video ? (
              <video
                src={`${base}${entry.data.video}`}
                poster={`${base}${entry.data.image}`}
                aria-label={entry.data.aiDescription ? `${entry.data.aiDescription} live photo` : `${entry.data.title} live photo`}
                muted
                loop
                playsinline
                preload="none"
              ></video>
              <span class="video-control" aria-hidden="true">Play</span>
            ) : (
              <img
                src={`${base}${entry.data.image}`}
                alt={entry.data.aiDescription || entry.data.title}
                loading="lazy"
                decoding="async"
              />
            )}
          </div>
          <div class="card-body">
            <div class="card-header">
              <span class="card-category" data-category={entry.data.category}>
                {entry.data.category}
              </span>
            </div>
            <h2 class="card-title">{entry.data.title}</h2>
            <p class="card-excerpt">{entry.data.excerpt}</p>
            {entry.data.location && (
              <span class="card-location">{entry.data.location}</span>
            )}
            <div class="card-tags">
              {entry.data.tags.map(tag => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </main>
</Layout>

<style>
  .archive-page {
    max-width: var(--max-width);
    margin: 0 auto;
    padding-left: var(--spacing-md);
    padding-right: var(--spacing-md);
  }

  .page-header {
    margin-bottom: var(--spacing-lg);
  }

  .page-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 300;
    letter-spacing: 0.06em;
  }

  .page-subtitle {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    margin-top: var(--spacing-xs);
  }

  .page-description {
    margin-top: var(--spacing-md);
    font-size: 0.9375rem;
    line-height: 1.8;
    max-width: 480px;
  }

  .archive-nav {
    display: flex;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-xl);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--spacing-sm);
  }

  .filter-link {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    padding-bottom: var(--spacing-xs);
    border-bottom: 1px solid transparent;
    margin-bottom: -1px;
  }

  .filter-link.active {
    color: var(--color-text);
    border-bottom-color: var(--color-text);
  }

  .filter-link:hover {
    color: var(--color-text);
    opacity: 1;
  }

  .archive-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-lg) var(--spacing-md);
  }

  .archive-card {
    break-inside: avoid;
  }

  .card-image {
    aspect-ratio: 4/3;
    overflow: hidden;
    background: #e8e8e8;
    margin-bottom: var(--spacing-sm);
    position: relative;
  }

  .has-video {
    cursor: pointer;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .card-image video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.4s ease;
  }

  .archive-card:hover .card-image img,
  .archive-card:hover .card-image video {
    transform: scale(1.03);
  }

  .video-control {
    position: absolute;
    right: 0.5rem;
    bottom: 0.5rem;
    z-index: 2;
    display: none;
    padding: 0.2rem 0.45rem;
    background: rgb(250 250 250 / 0.9);
    color: var(--color-text);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .has-video.is-playing .video-control {
    opacity: 0.65;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.25rem;
  }

  .card-category {
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.6;
  }

  .card-category[data-category="秩序"] { color: #4a4a4a; }
  .card-category[data-category="物证"] { color: #8b7355; }
  .card-category[data-category="失控"] { color: #c44; }

  .card-title {
    font-size: 0.9375rem;
    font-weight: 400;
    letter-spacing: 0.03em;
    margin-bottom: 0.25rem;
  }

  .card-excerpt {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: 0.5rem;
  }

  .card-location {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    display: block;
    margin-bottom: 0.5rem;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .tag {
    font-size: 0.625rem;
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
    padding: 1px 6px;
    border: 1px solid var(--color-border);
    border-radius: 2px;
  }

  @media (max-width: 768px) {
    .archive-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-md);
    }

    .video-control {
      display: inline-block;
    }
  }

  @media (max-width: 480px) {
    .archive-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.querySelectorAll('.has-video').forEach((container) => {
    const video = container.querySelector('video');
    const control = container.querySelector('.video-control');
    if (!video) return;

    const play = () => {
      video.play().then(() => {
        container.classList.add('is-playing');
        if (control) control.textContent = 'Pause';
      }).catch(() => {});
    };

    const stop = () => {
      video.pause();
      video.currentTime = 0;
      container.classList.remove('is-playing');
      if (control) control.textContent = 'Play';
    };

    container.addEventListener('mouseenter', play);
    container.addEventListener('mouseleave', stop);

    container.addEventListener('click', () => {
      if (video.paused) {
        play();
      } else {
        stop();
      }
    });
  });
</script>
