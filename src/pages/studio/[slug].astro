---
import Layout from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('studio');
  return entries.map(entry => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path?: string) => {
  if (!path) return undefined;
  if (/^(https?:|mailto:)/.test(path)) return path;
  return `${base}${path.startsWith('/') ? path : `/${path}`}`;
};

const worksCollection = await getCollection('works');
const series = worksCollection.find(w => w.id.replace(/\.md$/, '').endsWith(data.sourceSeries));
const allImages = [
  ...(series?.data.images || []),
  ...(series?.data.diptychImages || []),
];
const artwork = allImages.find(img => img.id === data.sourceWork);
const title = artwork?.caption?.split(',')[0]?.trim() || data.sourceWork;
const imagePath = series ? `${base}/images/works/${data.sourceSeries}/${data.sourceImage}` : '';
---

<Layout title={`${title} — Studio`} description={artwork?.description || title}>
  <main class="viewing-sheet">
    <header class="sheet-header">
      <a href={`${base}/studio`} class="sheet-back">Studio</a>
    </header>

    <div class="sheet-layout">
      <div class="sheet-image">
        <img
          src={imagePath}
          alt={artwork?.altText || title}
          loading="eager"
          decoding="async"
        />
      </div>

      <aside class="sheet-meta">
        <div class="meta-primary">
          <h1 class="meta-title">{title}</h1>
          {series && <p class="meta-series">{series.data.title}</p>}
        </div>

        <dl class="meta-specs">
          {artwork?.year && <div class="meta-spec"><span class="meta-spec-label">Year</span> <span>{artwork.year}</span></div>}
          {artwork?.medium && <div class="meta-spec"><span class="meta-spec-label">Medium</span> <span>{artwork.medium}</span></div>}
          {artwork?.dimensions && <div class="meta-spec"><span class="meta-spec-label">Dimensions</span> <span>{artwork.dimensions}</span></div>}
        </dl>

        <div class="meta-conditions">
          <span class="meta-cond">
            <span class="status-dot" data-status={data.availability.toLowerCase().replace(/\s+/g, '-')}></span>
            {data.availability}
          </span>
          {data.signature && <span class="meta-cond">{data.signature}</span>}
          {data.framingStatus && <span class="meta-cond">{data.framingStatus}</span>}
          {data.certificate && <span class="meta-cond">Certificate of Authenticity included</span>}
        </div>

        {data.collectorNote && (
          <p class="meta-note">{data.collectorNote}</p>
        )}

        {data.inquiryLink && (
          <a href={withBase(data.inquiryLink)} class="meta-inquire">Inquire <span class="inquire-arrow">&rarr;</span></a>
        )}

        <p class="meta-return">
          <a href={`${base}/studio`}>View all studio works</a>
        </p>
      </aside>
    </div>
  </main>
</Layout>

<style>
  .viewing-sheet {
    max-width: 1024px;
    margin: 0 auto;
    padding: calc(var(--spacing-xl) + 4rem) var(--spacing-md) var(--spacing-xl);
  }

  .sheet-header {
    margin-bottom: var(--spacing-lg);
  }

  .sheet-back {
    font-family: var(--font-sans);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-text-muted);
    display: inline-block;
  }

  .sheet-back:hover {
    color: var(--color-text);
  }

  .sheet-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: var(--spacing-xl);
    align-items: start;
  }

  .sheet-image {
    background: #f5f4f2;
  }

  .sheet-image img {
    width: 100%;
    display: block;
  }

  .sheet-meta {
    position: sticky;
    top: 5rem;
    font-family: var(--font-sans);
  }

  .meta-primary {
    margin-bottom: var(--spacing-md);
  }

  .meta-title {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 300;
    letter-spacing: 0.04em;
    line-height: 1.3;
    margin-bottom: 0.25em;
  }

  .meta-series {
    font-family: var(--font-sans);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
    opacity: 0.5;
  }

  .meta-specs {
    margin-bottom: var(--spacing-md);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .meta-spec {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    letter-spacing: 0.03em;
  }

  .meta-spec-label {
    font-family: var(--font-sans);
    font-size: 0.5625rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    opacity: 0.4;
    margin-right: 0.5rem;
  }

  .meta-conditions {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    letter-spacing: 0.03em;
    padding: var(--spacing-sm) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--spacing-md);
  }

  .meta-cond {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .status-dot {
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-text-muted);
    opacity: 0.5;
    flex-shrink: 0;
  }

  .status-dot[data-status="available"] {
    background: #5a8a6a;
    opacity: 1;
  }

  .meta-note {
    font-family: var(--font-serif);
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    font-style: italic;
    margin-bottom: var(--spacing-md);
  }

  .meta-inquire {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    transition: color 0.2s ease;
  }

  .meta-inquire .inquire-arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .meta-inquire:hover {
    color: var(--color-text);
  }

  .meta-inquire:hover .inquire-arrow {
    transform: translateX(3px);
  }

  .meta-return {
    margin-top: var(--spacing-lg);
  }

  .meta-return a {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
  }

  .meta-return a:hover {
    color: var(--color-text);
  }

  @media (max-width: 768px) {
    .viewing-sheet {
      padding: calc(var(--spacing-lg) + 3rem) var(--spacing-sm) var(--spacing-lg);
    }

    .sheet-layout {
      grid-template-columns: 1fr;
    }

    .sheet-meta {
      position: static;
    }

    .meta-title {
      font-size: 1.125rem;
    }
  }
</style>
