---
import Layout from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const studioEntries = await getCollection('studio');
const worksCollection = await getCollection('works');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path?: string) => {
  if (!path) return undefined;
  if (/^(https?:|mailto:)/.test(path)) return path;
  return `${base}${path.startsWith('/') ? path : `/${path}`}`;
};

const resolved = studioEntries.map(entry => {
  const { data } = entry;
  const series = worksCollection.find(w => w.id.replace(/\.md$/, '').endsWith(data.sourceSeries));
  const allImages = [
    ...(series?.data.images || []),
    ...(series?.data.diptychImages || []),
  ];
  const artwork = allImages.find(img => img.id === data.sourceWork);
  const title = artwork?.caption?.split(',')[0]?.trim() || data.sourceWork;
  return {
    slug: entry.id.replace(/\.md$/, ''),
    sourceImage: data.sourceImage,
    title,
    seriesName: series?.data.title || data.sourceSeries,
    year: artwork?.year,
    medium: artwork?.medium,
    dimensions: artwork?.dimensions,
    altText: artwork?.altText,
    availability: data.availability,
    signature: data.signature,
    certificate: data.certificate,
    framingStatus: data.framingStatus,
    collectorNote: data.collectorNote,
    inquiryLink: withBase(data.inquiryLink),
    imagePath: series ? `${base}/images/works/${data.sourceSeries}/${data.sourceImage}` : '',
  };
});
---

<Layout title="Studio" description="Selected works currently available directly from the artist's studio.">
  <main class="studio-page">
    <header class="page-header">
      <h1 class="page-title">Studio</h1>
      <p class="studio-desc">Selected works currently available directly from the artist's studio.</p>
    </header>

    <div class="studio-works">
      {resolved.map(work => (
        <section class="studio-work">
          <div class="work-image-wrap">
            <img
              src={work.imagePath}
              alt={work.altText || work.title}
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="work-info">
            <div class="work-header">
              <h2 class="work-title">{work.title}</h2>
              <p class="work-series">{work.seriesName}</p>
            </div>

            <dl class="work-specs">
              {work.year && <div class="spec"><span class="spec-label">Year</span> <span>{work.year}</span></div>}
              {work.medium && <div class="spec"><span class="spec-label">Medium</span> <span>{work.medium}</span></div>}
              {work.dimensions && <div class="spec"><span class="spec-label">Dimensions</span> <span>{work.dimensions}</span></div>}
            </dl>

            <div class="work-conditions">
              <span class="cond-item">
                <span class="status-dot" data-status={work.availability.toLowerCase().replace(/\s+/g, '-')}></span>
                {work.availability}
              </span>
              {work.signature && <span class="cond-sep">/</span>}
              {work.signature && <span class="cond-item">{work.signature}</span>}
              {work.framingStatus && <span class="cond-sep">/</span>}
              {work.framingStatus && <span class="cond-item">{work.framingStatus}</span>}
              {work.certificate && <span class="cond-sep">/</span>}
              {work.certificate && <span class="cond-item">CoA included</span>}
            </div>

            {work.collectorNote && (
              <p class="collector-note">{work.collectorNote}</p>
            )}

            {work.inquiryLink && (
              <a href={work.inquiryLink} class="inquire-link">Inquire <span class="inquire-arrow">&rarr;</span></a>
            )}
          </div>
        </section>
      ))}
    </div>
  </main>
</Layout>

<style>
  .studio-page {
    max-width: 960px;
    margin: 0 auto;
    padding: calc(var(--spacing-xl) + 4rem) var(--spacing-md) var(--spacing-xl);
  }

  /* Header */
  .page-header {
    margin-bottom: calc(var(--spacing-xl) + 3rem);
  }

  .page-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 300;
    letter-spacing: 0.06em;
  }

  .studio-desc {
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    font-style: italic;
    max-width: 460px;
    margin-top: var(--spacing-xs);
  }

  /* Works */
  .studio-works {
    display: flex;
    flex-direction: column;
  }

  .studio-work {
    padding: var(--spacing-xl) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .studio-work:first-child {
    padding-top: 0;
  }

  .studio-work:last-child {
    border-bottom: none;
  }

  /* Image */
  .work-image-wrap {
    margin-bottom: var(--spacing-lg);
    background: #f5f4f2;
  }

  .work-image-wrap img {
    width: 100%;
    display: block;
  }

  /* Info */
  .work-info {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-md) var(--spacing-xl);
  }

  .work-header {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .work-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 300;
    letter-spacing: 0.04em;
    line-height: 1.3;
    margin-bottom: 0.2em;
  }

  .work-series {
    font-family: var(--font-sans);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
    opacity: 0.5;
  }

  /* Specs */
  .work-specs {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: baseline;
    grid-column: 2;
  }

  .spec {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    letter-spacing: 0.03em;
  }

  .spec-label {
    font-family: var(--font-sans);
    font-size: 0.5625rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    opacity: 0.45;
    margin-right: 0.35rem;
  }

  /* Conditions */
  .work-conditions {
    grid-column: 1 / -1;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    letter-spacing: 0.03em;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
  }

  .status-dot {
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    margin-right: 0.25rem;
    vertical-align: middle;
    background: var(--color-text-muted);
    opacity: 0.5;
  }

  .status-dot[data-status="available"] {
    background: #5a8a6a;
    opacity: 1;
  }

  .cond-sep {
    opacity: 0.25;
    margin: 0 0.15rem;
  }

  /* Collector note */
  .collector-note {
    grid-column: 1 / -1;
    font-family: var(--font-serif);
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    font-style: italic;
    margin-top: var(--spacing-xs);
  }

  /* Inquire */
  .inquire-link {
    grid-column: 1 / -1;
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    margin-top: var(--spacing-sm);
    transition: color 0.2s ease;
  }

  .inquire-arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .inquire-link:hover {
    color: var(--color-text);
  }

  .inquire-link:hover .inquire-arrow {
    transform: translateX(3px);
  }

  /* Mobile */
  @media (max-width: 768px) {
    .studio-page {
      padding: calc(var(--spacing-lg) + 3rem) var(--spacing-sm) var(--spacing-lg);
    }

    .studio-work {
      padding: var(--spacing-lg) 0;
    }

    .work-info {
      grid-template-columns: 1fr;
    }

    .work-specs {
      grid-column: 1;
    }

    .work-title {
      font-size: 1.125rem;
    }
  }
</style>
