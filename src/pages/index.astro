---
import Layout from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="艺术家个人网站"
  description="当代艺术家个人网站 — 作品、文字、档案"
  ogImage={`${base}/images/placeholder/featured.jpg`}
>
  <main class="home">
    <section class="hero">
      <img
        src={`${base}/signature-hero.png`}
        alt="Hydon BAI"
        class="hero-signature"
        width="506"
        height="200"
        fetchpriority="high"
        decoding="async"
      />
      <p class="manifesto">
        在秩序与失控之间，寻找可被凝视的沉默。
      </p>
    </section>

    <section class="featured-work">
      <video
        src={`${base}/videos/featured.mp4`}
        class="featured-video"
        autoplay
        loop
        muted
        playsinline
        width="640"
        height="368"
      ></video>
      <p class="work-caption"></p>
    </section>

    <nav class="entry-grid">
      <a href={`${base}/works`} class="entry-card">
        <span class="entry-label">Works</span>
        <span class="entry-desc">作品与系列</span>
      </a>
      <a href={`${base}/notes`} class="entry-card">
        <span class="entry-label">Notes</span>
        <span class="entry-desc">观察与文字</span>
      </a>
      <a href={`${base}/archive`} class="entry-card">
        <span class="entry-label">Archive</span>
        <span class="entry-desc">秩序 · 物证 · 失控</span>
      </a>
      <a href={`${base}/studio`} class="entry-card">
        <span class="entry-label">Studio</span>
        <span class="entry-desc">可收藏作品</span>
      </a>
    </nav>
  </main>
</Layout>

<style>
  .home {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--spacing-xl) var(--spacing-md);
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .hero {
    margin-bottom: calc(var(--spacing-xl) + 2rem);
  }

  .hero-signature {
    display: block;
    width: 100%;
    max-width: 420px;
    height: auto;
    margin-bottom: var(--spacing-lg);
  }

  .manifesto {
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    max-width: 420px;
    line-height: 1.8;
    letter-spacing: 0.03em;
  }

  .featured-work {
    margin-bottom: var(--spacing-xl);
  }

  .featured-video {
    display: block;
    width: 100%;
    height: auto;
    background: #e8e8e8;
  }

  .work-caption {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-top: 0.75rem;
    letter-spacing: 0.05em;
  }

  .entry-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-sm);
    border-top: 1px solid var(--color-border);
    padding-top: var(--spacing-lg);
  }

  .entry-card {
    padding: var(--spacing-sm) 0;
    transition: opacity 0.2s ease;
  }

  .entry-card:hover {
    opacity: 0.5;
  }

  .entry-label {
    display: block;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    margin-bottom: 0.25rem;
  }

  .entry-desc {
    display: block;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .hero {
      margin-bottom: var(--spacing-xl);
    }

    .hero-signature {
      max-width: 100%;
      margin-bottom: var(--spacing-md);
    }

    .manifesto {
      font-size: 0.875rem;
      max-width: 100%;
    }

    .entry-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-md);
    }

    .featured-video {
      width: 100%;
    }

    .home {
      padding-top: 6rem;
    }
  }
</style>
