  }

  .preface-en .lead {
    font-size: 0.95rem;
    color: var(--thorn-ink);
  }

  .thorn-rule {
    width: 72px;
    height: 3px;
    margin: var(--spacing-xl) 0;
    background: var(--thorn-red);
  }

  .chapter {
    padding: var(--spacing-xl) 0;
  }

  .chapter-marker {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    gap: 1rem;
    align-items: center;
    margin-bottom: var(--spacing-lg);
    padding-bottom: 0.8rem;
