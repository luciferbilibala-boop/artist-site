    margin-top: 1rem;
    padding-left: 1.5rem;
    font-family: Georgia, var(--font-serif);
    font-size: 0.75rem;
    line-height: 1.7;
    font-style: italic;
    color: var(--thorn-muted);
  }

  .hero-art {
    margin: 0;
  }

