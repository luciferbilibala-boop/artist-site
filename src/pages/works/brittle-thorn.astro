  }

  .series-closing {
    margin: 0 calc(-1 * var(--spacing-md));
    padding: clamp(4rem, 9vw, 8rem) var(--spacing-md);
    background: var(--thorn-ink);
    text-align: center;
  }

  .series-closing p {
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 3vw, 2rem);
    line-height: 1.75;
