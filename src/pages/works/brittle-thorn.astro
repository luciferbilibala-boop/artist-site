    max-width: 430px;
    font-size: 0.8125rem;
    line-height: 1.65;
    letter-spacing: 0.04em;
    color: var(--thorn-muted);
  }

  .hero-copy blockquote {
    margin-top: clamp(3rem, 7vw, 6rem);
    padding-left: 1.25rem;
    border-left: 3px solid var(--thorn-red);
    font-family: var(--font-serif);
