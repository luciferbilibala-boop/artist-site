    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: center;
  }

  .chapter-portrait .chapter-layout {
    grid-template-columns: minmax(320px, 0.82fr) minmax(0, 1fr);
  }

  .work-image {
    margin: 0;
    background: var(--thorn-paper);
  }

  .work-image img {
    width: 100%;
    display: block;
  }

  .work-image-square {
    max-width: 680px;
  }

  .work-image-portrait {
    max-width: 560px;
  }

  .work-image-wide {
    width: 100%;
    margin-bottom: var(--spacing-lg);
  }

  .work-copy h2 {
    margin-bottom: 0.35rem;
    font-family: Georgia, var(--font-serif);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 300;
    letter-spacing: 0.01em;
  }

  .work-copy h2 span {
    display: block;
    margin-top: 0.35rem;
    font-family: var(--font-serif);
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    color: var(--thorn-muted);
  }

  .work-meta {
    margin-bottom: var(--spacing-md);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--thorn-red);
  }

  .work-cn {
    font-family: var(--font-serif);
  }

  .work-cn p {
    margin-bottom: 0.85rem;
    font-size: 0.9375rem;
    line-height: 1.95;
    letter-spacing: 0.025em;
    color: var(--thorn-ink);
  }

