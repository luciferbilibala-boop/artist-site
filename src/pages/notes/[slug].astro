---
import Layout from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map(note => ({
    params: { slug: note.id.replace(/\.md$/, '') },
    props: { note },
  }));
}

const { note } = Astro.props;
const { data } = note;
const { Content } = await note.render();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title={`${data.title} — Notes`} description={data.excerpt}>
  <main class="note-detail page-padding">
    <header class="note-header">
      <a href={`${base}/notes`} class="back-link">← Notes</a>
      <div class="note-meta-top">
        <span class="note-category">{data.category}</span>
        <time datetime={data.date.toISOString()}>
          {data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </div>
      <h1 class="note-title">{data.title}</h1>
    </header>

    {data.coverImage && (
      <div class="note-cover">
        <img src={`${base}${data.coverImage}`} alt={data.title} />
      </div>
    )}

    {data.type === 'video' && data.videoUrl && (
      <div class="note-video">
        <video src={`${base}${data.videoUrl}`} controls class="video-player" />
      </div>
    )}

    <div class="note-body">
      <Content />
    </div>

    {data.tags && data.tags.length > 0 && (
      <div class="note-tags">
        {data.tags.map(tag => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    )}
  </main>
</Layout>

<style>
  .note-detail {
    max-width: 680px;
    margin: 0 auto;
    padding-left: var(--spacing-md);
    padding-right: var(--spacing-md);
  }

  .note-header {
    margin-bottom: var(--spacing-lg);
  }

  .back-link {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    display: inline-block;
    margin-bottom: var(--spacing-md);
  }

  .note-meta-top {
    display: flex;
    gap: var(--spacing-sm);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-sm);
  }

  .note-category {
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .note-title {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 300;
    letter-spacing: 0.04em;
    line-height: 1.4;
  }

  .note-cover {
    margin-bottom: var(--spacing-lg);
  }

  .note-cover img {
    width: 100%;
    background: #e8e8e8;
    min-height: 300px;
    object-fit: cover;
  }

  .note-video {
    margin-bottom: var(--spacing-lg);
  }

  .video-player {
    width: 100%;
    aspect-ratio: 16/9;
    background: #000;
  }

  .note-body {
    margin-bottom: var(--spacing-lg);
  }

  .note-body :global(h2) {
    font-size: 1.25rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    margin-bottom: var(--spacing-sm);
    margin-top: var(--spacing-lg);
  }

  .note-body :global(p) {
    margin-bottom: var(--spacing-sm);
    line-height: 1.9;
  }

  .note-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    padding: 2px 10px;
    border: 1px solid var(--color-border);
    border-radius: 2px;
  }
</style>
